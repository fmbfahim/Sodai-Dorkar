<IfModule mod_rewrite.c>
    RewriteEngine On

    # Strip /public/ from browser address bar if someone opens it
    RewriteCond %{THE_REQUEST} \s/public/([^\s?]*) [NC]
    RewriteRule ^ %1 [R=301,L]

    # Strip legacy /sodai-dorkar/public/ if accessed
    RewriteCond %{THE_REQUEST} \s/sodai-dorkar/public/([^\s?]*) [NC]
    RewriteRule ^ %1 [R=301,L]

    # Internally rewrite everything to the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
